# LocalVoiceAI configuration (copy to .env)

HOST=127.0.0.1
PORT=7860
FRONTEND_ORIGIN=http://127.0.0.1:5173

DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/localvoiceai.db
MODELS_DIR=./models
SETTINGS_PATH=./data/settings.json

# Languages
PRIMARY_LANGUAGE=bn-BD
SECONDARY_LANGUAGE=en
LANGUAGE_MODE=auto
AUTO_LANGUAGE_ROUTING=true

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_MODEL_FALLBACK=qwen3:1.7b
OLLAMA_MODEL_QUALITY=qwen3.5:4b

PERFORMANCE_PROFILE=auto

# Speech
STT_PROVIDER=whisper_turbo
STT_FALLBACK=moonshine
STT_MODEL=large-v3-turbo
MOONSHINE_MODEL=tiny-streaming

BENGALI_TTS_PROVIDER=indic_parler
BENGALI_TTS_MODEL=ai4bharat/indic-parler-tts
BENGALI_TTS_VOICE=Aditi
ENGLISH_TTS_PROVIDER=kokoro
TTS_VOICE=af_heart
TTS_SPEED=1.0
SAMPLE_RATE=16000

# Hugging Face (required for gated Indic Parler)
# Accept terms: https://huggingface.co/ai4bharat/indic-parler-tts
# HF_TOKEN=

# Turn detection
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.2
SMART_TURN_STOP_SECS=3.0
MAX_UTTERANCE_SECS=30.0
PUSH_TO_TALK=false

MAX_RESPONSE_SENTENCES=3
LLM_TEMPERATURE=0.7
LLM_CONTEXT_TOKENS=8192
THINKING_MODE=false

# Memory (multilingual E5; legacy BGE index preserved under vectors/bge-*)
MEMORY_CONSENT_DEFAULT=false
MEMORY_TOP_K=5
MEMORY_TOKEN_BUDGET=800
WORKING_MEMORY_TOKEN_BUDGET=1500
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_INDEX_VERSION=e5-small-v1
LEGACY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BILINGUAL_MEMORY=true

RECORD_RAW_AUDIO=false
ENABLE_TELEMETRY=false
LOG_LEVEL=INFO

DEFAULT_USER_ID=local-user
DEFAULT_USER_NAME=Local User
