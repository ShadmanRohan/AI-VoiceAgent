# LocalVoiceAI configuration (copy to .env)

# Network — bind to localhost by default
HOST=127.0.0.1
PORT=7860
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Paths
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/localvoiceai.db
MODELS_DIR=./models
SETTINGS_PATH=./data/settings.json

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_MODEL_QUALITY=qwen3:4b-instruct

# Performance profile: auto | low | balanced | quality
PERFORMANCE_PROFILE=auto

# Speech
STT_PROVIDER=moonshine
STT_FALLBACK=whisper
MOONSHINE_MODEL=tiny-streaming
TTS_VOICE=af_heart
TTS_SPEED=1.0
SAMPLE_RATE=16000

# Turn detection
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.2
SMART_TURN_STOP_SECS=3.0
MAX_UTTERANCE_SECS=30.0
PUSH_TO_TALK=false

# LLM — leave unset to use the built-in voice assistant prompt
# SYSTEM_PROMPT=
MAX_RESPONSE_SENTENCES=3
LLM_TEMPERATURE=0.7
LLM_CONTEXT_TOKENS=4096
THINKING_MODE=false

# Memory
MEMORY_CONSENT_DEFAULT=false
MEMORY_TOP_K=5
MEMORY_TOKEN_BUDGET=800
WORKING_MEMORY_TOKEN_BUDGET=1500
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Privacy
RECORD_RAW_AUDIO=false
ENABLE_TELEMETRY=false
LOG_LEVEL=INFO

# Default local user (single-user mode)
DEFAULT_USER_ID=local-user
DEFAULT_USER_NAME=Local User
